{
  "info": {
    "name": "BookTrack",
    "description": "Tutte le rotte di BookTrack in ordine di flusso. Login salva il token da solo; salvataggio, scaffali e recensioni salvano i loro id.\nEseguite le cartelle dall'alto verso il basso (o 'Run collection').\nPrima di esportare/committare: svuotate la variabile token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": "prova@test.it"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "tipo",
      "value": "book"
    },
    {
      "key": "query",
      "value": "dune"
    },
    {
      "key": "idEsterno",
      "value": ""
    },
    {
      "key": "contenutoId",
      "value": ""
    },
    {
      "key": "listaId",
      "value": ""
    },
    {
      "key": "commentoId",
      "value": ""
    },
    {
      "key": "listaId2",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Utenti",
      "item": [
        {
          "name": "Registrazione",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "201 la prima volta, 409 se l'email esiste già (es. dopo npm run seed).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Utente di prova\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
