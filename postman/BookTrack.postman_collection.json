            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "// Salva token nelle variabili della collection",
                  "const json = pm.response.json();",
                  "if (json.success) { pm.collectionVariables.set(\"token\", json.data.token); }"
                ]
              }
            }
          ]
        },
