
# .env.example

# 1. Copiate questo file in ".env"   (cp .env.example .env)
# 2. Mettete i valori veri nel .env
# 3. Il .env NON va su GitHub (è nel .gitignore). Questo file invece SÌ.
#
# Nota Bun: Bun legge il .env da solo, non serve il pacchetto dotenv.
# Tutte le variabili sono lette in UN solo posto: config/env.config.ts


# --- Server ---
PORT=3000

# --- Database (MongoDB locale o Atlas) ---
MONGO_URI=mongodb://127.0.0.1:27017/booktrack

# --- JWT ---
# Stringa lunga e casuale. Generatela con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiami-con-una-stringa-lunga-e-casuale
JWT_EXPIRES_IN=1h

# --- Open Library (libri) ---
# Non serve nessuna chiave API.
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_COVERS_URL=https://covers.openlibrary.org
